import "HCLass_Core_Member" as Member

number = Member.Attribute({
    "__metadata__": {
        "name": "num1", 
        "dataType": "int",
    },
    "body": null,
})

print(number)
print(number.Get())
print(number.Set(5).Get())

methodTest = Member.Method({
    "__metadata__": {
        "name": "MethodTest", 
    },
    "body": func(args) { print("Hi from test"); return null },
})

print(methodTest)
methodTest.Call({"_this": 10})



main = rule {
    true
}