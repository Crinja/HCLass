import "Members"

_scopes = ["public", "protected", "private"]

_class_factory = func(args) {
    namespace = {}

    get_context = func() { // Callback function
        context = {}

        for _scopes as scope {
            for namespace[scope] as member_name, member {
                context[member_name] = member
            }
        }

        return context
    }

    for _scopes as scope {
        namespace[scope] = {}
    }

    if "name" not in args {
        error("Name must be provided when creating a class.")
    }
    namespace["name"] = args.name

    if "inherits" in args { // Check if we inherit any classes
        for args.inherits as inherit {
            super = _class_factory(inherit[0](inherit[1])) // Create the parent class

            // Create an interface the child object can view
            interface = {}
            for super as scope_name, scope {
                if scope_name is not "private" and scope_name is not "name" {
                    // Add public and protected members to the namespace of the child class
                    // Order of precedence is the order they are provided to the child R->L
                    // Members will also be overriden by the child class to allow for polymorphism
                    // Overriden members are still available through the parent interface
                    for scope as member_name, member {
                        // This will only be true for inherited classes
                        // Which we only want to add to the class interface
                        if scope_name not in namespace { 
                            interface[scope_name] = scope
                        } else {
                            namespace[scope_name][member_name] = member
                            interface[member_name] = member
                        }
                    }
                }
            }

            namespace[super.name] = interface
        }
    }

    for _scopes as scope {
        if scope in args {
            for args[scope] as member_name, member {
                if member_name is "attribute" {
                    for member as attr_name, attr {
                        namespace[scope][attr_name] = Member.New(attr[0], attr[1])
                    }
                }
                if member_name is "method" {
                    for member as method_name, method {
                        namespace[scope][method_name] = method(get_context)
                    }
                }
            }
        }
    }

    return namespace
}

New = func(args) {
    raw_class = _class_factory(args)

    print(raw_class)

    // Remove all private members from public interface
    public_interface = {}
    for raw_class as scope_name, scope {
        if scope_name is "public" {
            for scope as member_name, member {
                public_interface[member_name] = member
            }
        }
        if scope_name is "name" {
            public_interface[scope_name] = scope 
        }
    }

    return public_interface
}