import "Assert" as Assert
import "Core" as lCore
import "Member" as lMember

Core = lCore.Exports
Member = lMember.Exports

# --- Test Data Setup ---

# 1. Parent Class Definition
_parent_def = func(args) {
    return {
        "name": "GrandParent",
        "public": {
            "attribute": { "pub_val": ["int", 100] },
        },
        "protected": {
            "attribute": { "prot_val": ["int", 50] },
        },
        "private": {
            "attribute": { "priv_val": ["int", 10] },
        },
    }
}

# 2. Child Class Definition (Inherits GrandParent)
_child_def = func(args) {
    return {
        "name": "Child",
        "inherits": [[_parent_def, {}]],
        "public": {
            "method": {
                # Helper to expose internal state for testing purposes
                "reveal_state": func(ctx_resolver) {
                    return func() {
                        # 1. CALL the resolver to get the actual data map
                        context_map = ctx_resolver() 

                        # 2. Check keys inside the MAP, not the function
                        return {
                            "can_see_pub":  "pub_val"  in context_map,
                            "can_see_prot": "prot_val" in context_map,
                            "can_see_priv": "priv_val" in context_map,
                        }
                    }
                },
            },
        },
    }
}

# --- The Test Runner ---

run = func() {
    results = []
    
    # Instantiate the objects
    parent_obj = Core.Class(_parent_def({}))
    child_obj  = Core.Class(_child_def({}))

    # TEST 1: Public Interface Integrity
    # The parent object should ONLY show 'pub_val' and 'name'
    results += [Assert.True("Parent: Has Name", "name" in parent_obj)]
    results += [Assert.True("Parent: Has Public Member", "pub_val" in parent_obj)]
    
    # TEST 2: Strict Privacy (Encapsulation)
    # The parent object must NOT expose protected or private members to the outside world
    results += [Assert.NotKey("Parent: Hides Protected", parent_obj, "prot_val")]
    results += [Assert.NotKey("Parent: Hides Private", parent_obj, "priv_val")]

    # TEST 3: Inheritance & Scope Visibility
    # We ask the Child object: "What variables can you see internally?"
    internal_view = child_obj.reveal_state()

    # 3a. Child should see Parent's Public vars
    results += [Assert.True("Inheritance: Child sees Public", internal_view.can_see_pub)]

    # 3b. Child should see Parent's Protected vars (CRITICAL for OOP)
    results += [Assert.True("Inheritance: Child sees Protected", internal_view.can_see_prot)]

    # 3c. Child should NOT see Parent's Private vars
    # This proves that 'private' is truly local to the defining class
    results += [Assert.Equal("Inheritance: Child cannot see Private", internal_view.can_see_priv, false)]

    return all results as r { r }
}