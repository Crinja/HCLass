import "Test.Attribute" as TestAttribute
import "Test.Method" as TestMethod
import "Test.Class" as TestClass

print("--- STARTING TEST SUITE ---")

tests = {
    "Attribute Tests": TestAttribute.run,
    "Method Tests": TestMethod.run,
    "Class Tests": TestClass.run,
}

all_tests_valid = true

for tests as name, test {
    results = test()

    print("--- SUMMARY ---")
    print(name + ": " + string(results))

    if results is false {
        all_tests_valid = false
    }
}

main = rule {
    all_tests_valid
}