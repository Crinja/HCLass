import "Member" as Member_Exports
import "Assert" as Assert

Member = Member_Exports.Exports

run = func() {
    results = []
    
    # --- Setup Mocks ---
    # 1. A mock "State" (what 'this' would look like inside an object)
    mock_state = {
        "multiplier": 2,
        "name": "TestObject",
    }

    # 2. A mock "Context Resolver" (The callback provided by the class factory)
    # In a real class, this function finds the current state. 
    # Here, we just return our static mock_state.
    get_context = func() {
        return mock_state
    }

    # --- Test 1: Method WITH Arguments (MethodBinder / Binder) ---
    
    # Define raw logic: takes (context, payload)
    raw_multiply = func(ctx, num) {
        return ctx.multiplier * num
    }

    # Create the method
    # Step A: Create the Factory (Binder)
    method_factory = Member.Method(raw_multiply)
    # Step B: Bind it to our context
    bound_method = method_factory(get_context)

    # Execute and Assert
    # Should be 2 * 10 = 20
    results += [Assert.Equal("Method: Args & Context", bound_method(10), 20)]


    # --- Test 2: Method WITHOUT Arguments (BinderNoArgs) ---

    # Define raw logic: takes (context) only
    raw_get_name = func(ctx) {
        return "Name is: " + ctx.name
    }

    # Create the method
    getter_factory = Member.Action(raw_get_name)
    bound_getter = getter_factory(get_context)

    # Execute and Assert
    # Should be "Name is: TestObject"
    results += [Assert.Equal("Method: NoArgs & Context", bound_getter(), "Name is: TestObject")]


    # --- Test 3: Dynamic Context Check ---
    # Ensure that if the state changes, the method sees it (because it calls get_context() every time)
    
    # Mutate the mock state
    mock_state["multiplier"] = 10
    
    # Execute the SAME bound method again
    # Should be 10 * 5 = 50 (not 2 * 5)
    results += [Assert.Equal("Method: Dynamic Context Update", bound_method(5), 50)]

    return all results as r { r }
}