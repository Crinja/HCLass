Equal = func(test_name, actual, expected) {
    if actual is expected {
        return true
    } else {
        print("[FAIL] " + test_name)
        print("       Expected: " + string(expected))
        print("       Got:      " + string(actual))
        return false
    }
}

NotKey = func(test_name, in_map, key) {
    if key not in in_map {
        return true
    } else {
        print("[FAIL] " + test_name + " (Key '" + key + "' was found but should be missing)")
        return false
    }
}

True = func(test_name, condition) {
    return Equal(test_name, condition, true)
}