import "Test_HCLass_Helper"

import "HCLass_Member"

attr = HCLass_Member.Attribute("int", 10)

_initial_value = func() {
    return Test_HCLass_Helper.Assert.Equal("Attribute: Get Initial Value", attr.Get(), 10)
}

_set_value = func() {
    attr.Set(50)

    return Test_HCLass_Helper.Assert.Equal("Attribute: Set Valid Value", attr.Get(), 50)
}

_set_wrong_type = func() {
    attr.Set("string") 
    
    return Test_HCLass_Helper.Assert.Equal("Attribute: Prevent Invalid Type", attr.Get(), 50)
}

Run = Test_HCLass_Helper.Test([_initial_value, _set_value, _set_wrong_type])