import "HCLass_Member"

# --- Configuration & Constants ---
# Centralized constants prevent typos and allow for easy keyword changes later.
SCOPES = ["public", "protected", "private"]
KEY_NAME = "name"
KEY_INHERITS = "inherits"
KEY_ATTR = "attribute"
KEY_METHOD = "method"

# --- Helper Functions ---

# Merges parent class members into the child's namespace.
# Handles polymorphism (overriding) and parent interface preservation.
_merge_inheritance = func(child_namespace, parent_def) {
    # parent_def expected to be [Constructor, Args]
    parent_ctor = parent_def[0]
    parent_args = parent_def[1]

    # Instantiate the parent class (Recursive call)
    parent_instance = _class_factory(parent_ctor(parent_args))
    
    parent_interface = {}

    # Iterate through parent scopes (skipping private)
    for parent_instance as scope_name, scope {
        
        # We only inherit public and protected members
        if scope_name is "private" or scope_name is KEY_NAME {
            continue
        }

        for scope as member_name, member {
            # 1. Build the 'super' interface (view of the parent)
            if scope_name not in parent_interface {
                parent_interface[scope_name] = {}
            }
            parent_interface[scope_name][member_name] = member

            # 2. Merge into child namespace for Polymorphism
            # If the child hasn't defined this scope, create it.
            # We overwrite existing keys here effectively allowing the child 
            # to "override" members if they share the same name.
            if scope_name not in child_namespace {
                child_namespace[scope_name] = {}
            }
            child_namespace[scope_name][member_name] = member
        }
    }

    # Store the parent interface on the child using the parent's name
    # e.g. child.ParentClass.someMethod()
    child_namespace[parent_instance[KEY_NAME]] = parent_interface
    
    return true
}

# The Core Logic Engine
_class_factory = func(args) {
    namespace = {}

    # 1. Initialize Scopes
    for SCOPES as scope {
        namespace[scope] = {}
    }

    # 2. Validation & Metadata
    if KEY_NAME not in args {
        error("ClassFactory Error: 'name' argument is mandatory.")
    }
    namespace[KEY_NAME] = args.name

    # 3. Inheritance Handling
    if KEY_INHERITS in args {
        for args[KEY_INHERITS] as parent_def {
            _merge_inheritance(namespace, parent_def)
        }
    }

    # 4. Context Closure ('this')
    # This function captures the specific instance's namespace.
    # It flattens scopes so methods can access variables directly.
    get_context = func() {
        context = {}
        for SCOPES as scope {
            if scope in namespace {
                for namespace[scope] as member_name, member {
                    context[member_name] = member
                }
            }
        }
        return context
    }

    # 5. Member Instantiation
    # Loops through the definition to create actual attributes and methods
    for SCOPES as scope {
        if scope in args {
            for args[scope] as type, members {
                
                # Handle Attributes
                if type is KEY_ATTR {
                    for members as name, def {
                        # def is expected to be [Type, DefaultValue]
                        namespace[scope][name] = Member.Attribute(def[0], def[1])
                    }
                }
                
                # Handle Methods
                if type is KEY_METHOD {
                    for members as name, method_func {
                        # Inject the context getter into the method
                        namespace[scope][name] = method_func(get_context)
                    }
                }
            }
        }
    }

    return namespace
}

# --- Public API ---

# The Public Constructor
# Creates the object and strips away private members/scopes
New = func(args) {
    # 1. Create the raw object with all scopes accessible
    raw_class = _class_factory(args)

    # 2. Build the Public Interface
    # We only return what is explicitly "public" or metadata
    public_interface = {}
    
    # Copy metadata
    public_interface[KEY_NAME] = raw_class[KEY_NAME]

    # Copy public members
    if "public" in raw_class {
        for raw_class["public"] as member_name, member {
            public_interface[member_name] = member
        }
    }

    return public_interface
}