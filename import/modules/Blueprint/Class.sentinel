import "HCLass_Core_Constants" as Constants

New = func(className) {
    _blueprint = {
       Constants.__META__.__KEY__: {
        Constants.__META__.__NAME__: className,
        Constants.__META__.__TYPE__: Constants.__TYPES__.__CLASS__,
       }, 
    }

    _functions = {
        "Inherits": func(baseBp) {
            if Constants.__TOKENS__.__INHERITS__ in _blueprint {
                error("Class cannot inherit more than one base class.")
            }

            if baseBp[Constants.__META__.__KEY__][Constants.__META__.__TYPE__] is not Constants.__TYPES__.__CLASS__ {
                error("Naughty")
            }
            _blueprint[Constants.__TOKENS__.__INHERITS__] = baseBp

            return _functions
        },
        "Implements": func(interface) {
            if Constants.__TOKENS__.__IMPLEMENTS__ not in _blueprint {
                _blueprint[Constants.__TOKENS__.__IMPLEMENTS__] = []
            }
            # TODO: Add check to interface metadata to confirm is interface
             append(_blueprint[Constants.__TOKENS__.__IMPLEMENTS__], interface)

            return _functions
        },
        "Assemble": func() {
            return _blueprint
        },
    }

    return _functions
}