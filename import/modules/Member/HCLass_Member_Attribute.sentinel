import "types" as Types

# TypedAttribute creates a mutable container with runtime type checking.
# It encapsulates the value in a closure to ensure type safety on updates.
TypedAttribute = func(expected_type, initial_value) {
    
    # Closure State: 
    # These variables are 'private' to this specific attribute instance.
    # They persist between Get/Set calls.
    bound_type = expected_type
    stored_value = initial_value

    return {
        # Accessor: Retrieve the current value
        "Get": func() {
            return stored_value
        },

        # Mutator: Update the value, but only if the type matches
        "Set": func(new_value) {
            
            # Validate type integrity before modification
            actual_type = Types.type_of(new_value)
            
            if actual_type is not bound_type {
                # TODO Error
                return undefined
            }

            stored_value = new_value
            return null
        },
    }
}